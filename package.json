{
  "name": "@nodejs/microtel",
  "private": true,
  "version": "0.0.0",
  "description": "Node.js OpenTelemetry built-in support",
  "license": "MIT",
  "author": "Node.js contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodejs/microtel.git"
  },
  "bugs": {
    "url": "https://github.com/nodejs/microtel/issues"
  },
  "homepage": "https://github.com/nodejs/microtel#readme",
  "keywords": [
    "opentelemetry",
    "tracing",
    "diagnostics_channel"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "engines": {
    "node": ">=26.9.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test 'test/test-*.js'",
    "bench": "node --experimental-bench --bench 'benchmark/*.bench.js'",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10"
  }
}
